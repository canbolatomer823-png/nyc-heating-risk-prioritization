[Unit]
Description=Omer news dashboard uvicorn service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/omer-news-dashboard
Environment=NEWS_DASHBOARD_HTML=/opt/omer-news-dashboard/dashboard.html
Environment=NEWS_PUBLIC_BASE_URL=https://www.dunyacongress.com/omer-news-dashboard-live
Environment=NEWS_PROXY_PATH=/omer-news-dashboard-live/
Environment=NEWS_DEPLOY_MODE=apache_reverse_proxy_uvicorn
Environment=NEWS_LOCAL_BIND=127.0.0.1:8011
Environment=NEWS_GIT_REV=replace-with-current-git-sha
ExecStart=/usr/local/bin/uvicorn asgi_dashboard:app --host 127.0.0.1 --port 8011
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
